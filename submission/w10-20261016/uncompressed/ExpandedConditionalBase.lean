theorem hasDerivAt_sc1 (θ : ℝ) : HasDerivAt sc1 (sc2 θ) θ := by
 rcases eq_or_ne θ 0 with rfl | h
 · have : sc2 0 = -1 / 3 := by simp [sc2]
   rw [this]; exact hasDerivAt_sc1_zero
 · exact hasDerivAt_sc1_of_ne h
