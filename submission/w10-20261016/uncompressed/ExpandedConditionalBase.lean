    (by fun_prop : Continuous fun s : ℝ => cos ((sqrt 2 - 2 * π * t) * s)).intervalIntegrable _ _
  have hi₂ : IntervalIntegrable (fun s : ℝ => cos ((sqrt 2 + 2 * π * t) * s))
      volume (-(1 : ℝ) / 2) (1 / 2) :=
    (by fun_prop : Continuous fun s : ℝ => cos ((sqrt 2 + 2 * π * t) * s)).intervalIntegrable _ _
  simp_rw [hp]
  rw [intervalIntegral.integral_div, intervalIntegral.integral_add hi₁ hi₂,
