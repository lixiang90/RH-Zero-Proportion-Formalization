def ce (a : SZ) (d : ℕ) : SZ :=
 Bool.rec (motive := fun _ => SZ) ⟨0, Nat.div (Nat.sub a.n a.p) d⟩ ⟨ndivc (Nat.sub a.p a.n) d, 0⟩ (Nat.ble a.n a.p)
