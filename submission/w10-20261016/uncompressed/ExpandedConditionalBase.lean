   have hq : |h| ^ 4 = h ^ 2 * h ^ 2 := by rw [← sq_abs h]; ring
   have hh2 : h ^ 2 ≤ 1 := by rw [← sq_abs]; nlinarith [abs_nonneg h]
   nlinarith [sq_nonneg h]
