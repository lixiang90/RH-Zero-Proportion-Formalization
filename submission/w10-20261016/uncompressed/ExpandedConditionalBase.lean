      = ((gMaj v * cos (2 * π * t * v) : ℝ) : ℂ)
        + ((gMaj v * sin (2 * π * t * v) : ℝ) : ℂ) * Complex.I := by
    intro v
    have hin : inner ℝ v t = t * v := by simp
    rw [hin, smul_eq_mul, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
      show 2 * π * (t * v) = 2 * π * t * v by ring]
    push_cast
    ring
