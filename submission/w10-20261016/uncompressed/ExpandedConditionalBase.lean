def SummedCertificate {n : ℕ} (W : WCert n) (c C : ℝ) : Prop :=
  ∀ {m : ℕ}, n ≤ m → ∀ y : Fin m → ℝ, StrictMono y →
    c * ((m : ℝ) - ((n - 1 : ℕ) : ℝ)) - C ≤
      ∑ i ∈ range (m - (n - 1)), Fw W (windowGaps n (sortedExt y) i)

