def walk (Q : ℕ) (PR : List (ℕ × ℕ)) (SL : List ℕ)
    (read : ℕ → ℕ) (leafCheck : Cl → ℕ → Bool) :
    ℕ → ℕ → Cl → ℕ
  | 0, _, _ => 0
  | fuel + 1, pos, c =>
    let w := read pos
    if w % 2 = 1 then
      let ax := (w / 2) % 64
      let i := sI Q PR ax
      let j := sJ Q PR ax
      let q := w / 128
      if i < j ∧ j ≤ Q then
