def DZ : ℕ := 1000000000000000
def ndivc (a b : ℕ) : ℕ := Nat.div (Nat.sub (Nat.add a b) 1) b
theorem DZ_pos : (0 : ℝ) < DZ := by norm_num [DZ]
theorem ndiv_le (a b : ℕ) (hb : 0 < b) : ((Nat.div a b : ℕ) : ℝ) ≤ (a : ℝ) / b := by
