theorem B0_enc (hc : c.ok = true) {x : ℝ} (hx1 : (c.LN : ℝ) / SC ≤ x) (hx2 : x ≤ (c.UN : ℝ) / SC) :
   c.B0.Enc (nsel c.k (fun j => Real.sinc (π * (x - j)))) := by
