def LMajBound : Prop := LMaj ≤ 179 / 100
def SeparatedBound : Prop :=
  ∀ (ι : Type) [Fintype ι] (y : ι → ℝ) (x : ι → ℝ) (w : ℝ → ℝ),
    (∀ i j, i ≠ j → sep ≤ |y i - y j|) →
    Measurable w → (∀ u, 0 ≤ w u) → (∀ u, w u ≤ gMaj u) →
    ∫ u, w u * (∑ i, ∑ j, x i * x j * Real.cos (2 * π * (y i - y j) * u)) ≤ LMaj * ∑ i, x i ^ 2
end Pantera
