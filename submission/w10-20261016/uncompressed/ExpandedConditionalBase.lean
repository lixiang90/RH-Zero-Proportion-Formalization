         mul_le_mul hg.2 b.bhi hpx (hG0.trans (hg.1.trans hg.2))
     _ = ((GAM1 : ℝ) * c.BUZ / DZ) / DZ := by ring
     _ ≤ _ := div_le_div_of_nonneg_right h1 hD.le
