 have hWr : (w : ℝ) * AMW.G.DZ * AMW.G.DZ ≤ (c.A.KAn : ℝ) * c.A.KAn * SW := by
   have := (Int.cast_le (R := ℝ)).mpr hW
   simp only [CellN.DHIZ, CellN.NLOZ, Int.cast_mul, Int.cast_natCast] at this; exact this
