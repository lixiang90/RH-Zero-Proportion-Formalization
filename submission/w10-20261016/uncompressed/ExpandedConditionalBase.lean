 · have : ¬ (c.k % 2 = 0 ∧ 2 ≤ c.k ∧ c.k ≤ 24) := fun h => by rw [(c.nearOn_iff).mpr h] at hn; exact absurd hn (by simp)
   rw [if_neg this, mul_zero]; exact IV.enc_zero
