 exact ⟨fun h => ⟨h.1.1, h.1.2, h.2⟩, fun h => ⟨⟨h.1, h.2.1⟩, h.2.2⟩⟩
theorem roff_near (hk : c.k % 2 = 0) (x : ℝ) :
   π * (x - ((c.k / 2 : ℕ) : ℝ)) = if c.side then π * c.roff x else -(π * c.roff x) := by
