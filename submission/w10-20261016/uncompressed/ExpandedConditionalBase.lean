    (hSum : c * ((m : ℝ) - ((n - 1 : ℕ) : ℝ)) - C ≤
      ∑ i ∈ range (m - (n - 1)), Fw W
        (windowGaps n (sortedExt ((univ.image x).orderEmbOfFin hS)) i)) :
    c * ((m : ℝ) - ((n - 1 : ℕ) : ℝ)) - C ≤
      (∑ r : Fin m × Fin m,
        if r.1 ≠ r.2 ∧ (r.1 : ℕ) ≤ (r.2 : ℕ) + (n - 1) ∧
          (r.2 : ℕ) ≤ (r.1 : ℕ) + (n - 1) then
