  linarith [normalized_KMT_at_sep_ge]
theorem kernel_ge_one_eighth {t : ℝ} (ht : |t| ≤ 17 / 20) :
    (1 / 8 : ℝ) ≤ AMW.kfunAM t := by
  by_cases ht0 : 0 ≤ t
  · have h := kernel_ge_nonneg ht0 ((le_abs_self t).trans ht)
    linarith
  · have htneg : t < 0 := lt_of_not_ge ht0
