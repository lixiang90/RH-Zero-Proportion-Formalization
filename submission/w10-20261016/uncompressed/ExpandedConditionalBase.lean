   have e : ((c.W1LO : ℤ) : ℝ) = (c.A.W1.lo.fl 1000000).v := by
     simp only [CellN.W1LO, AMW.G.SZ.v]; push_cast; ring
   rw [e]; unfold w1
   have h2 := hW.1
