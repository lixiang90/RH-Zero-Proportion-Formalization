  have hsabs : |s| ≤ 1 / 2 := abs_le.mpr ⟨by linarith [hs.1], hs.2⟩
  have hs2 : s ^ 2 ≤ 1 / 4 := by nlinarith [hs.1, hs.2]
  have hc0 : 0 ≤ cos (sqrt 2 * s) := by
    linarith [AMW.cos_sqrt2_ge (s := s)]
  have harg0 : 0 ≤ 2 * π * t * |s| := by positivity
