   rw [allQ, Bool.and_eq_true, ih]
   constructor
   · rintro ⟨h1, h2⟩ j hj
     rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h | h
     · exact h1 j h
     · exact h ▸ h2
   · intro h; exact ⟨fun j hj => h j (by omega), h n (by omega)⟩
