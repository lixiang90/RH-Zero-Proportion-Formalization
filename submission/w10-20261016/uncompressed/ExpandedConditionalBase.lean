 · obtain ⟨i, hi⟩ := h
   linarith [Finset.le_sup' x hi, Finset.inf'_le x hi]
 · exact le_rfl
def defect {M : Matrix ι ι ℂ} (hM : M.IsHermitian) : ℝ := rtrace (specMap hM Psi)
