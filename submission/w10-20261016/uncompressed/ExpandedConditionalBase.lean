 | succ n ih => rw [sumQ, ih, Finset.sum_range_succ]
theorem allQ_iff (f : ℕ → Bool) (n : ℕ) : allQ f n = true ↔ ∀ j < n, f j = true := by
 induction n with
 | zero => simp [allQ]
