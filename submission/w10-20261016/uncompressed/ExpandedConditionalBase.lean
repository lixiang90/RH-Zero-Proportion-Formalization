theorem T2_near (h2 : x + j ≠ 0) :
   (sc2 (π * (x - j)) + sc2 (π * (x + j))) / 2
     = sc2 (π * (x - j)) / 2 + (-1) ^ j * (-(Real.sin (π * x) / π) * hf 0 j x
