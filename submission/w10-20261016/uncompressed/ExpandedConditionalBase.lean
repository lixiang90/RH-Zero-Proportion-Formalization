     _ ≤ 2 * gamAM * (π * x) := mul_le_mul hg.1 b.blo hB0 (hG0.trans hg.1)
 · have h1 := le_ndivc (Nat.mul GAM1 c.BUZ) DZ (by norm_num [DZ])
   have e : ((Nat.mul GAM1 c.BUZ : ℕ) : ℝ) = (GAM1 : ℝ) * c.BUZ := by rw [Nat.mul_eq]; push_cast; ring
   rw [e] at h1
