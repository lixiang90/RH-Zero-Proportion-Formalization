   c * ((m : ℝ) - ((n : ℝ) - 1)) ≤ (∑ r : Fin m × Fin m,
       (if r.1 ≠ r.2 ∧ (r.1 : ℕ) ≤ (r.2 : ℕ) + (n - 1) ∧ (r.2 : ℕ) ≤ (r.1 : ℕ) + (n - 1)
         then wfun ((univ.image x).orderEmbOfFin hS r.1 - (univ.image x).orderEmbOfFin hS r.2) else 0))
     + blkPress W.b x univ := by
