   1000000000 * w1 ((p : ℝ) / SC) ≤ 2000000000 - (hi32 (hi32 (f p)) : ℝ) ∧
   ∀ s : ℝ, (L : ℝ) / SC ≤ s → s ≤ (U : ℝ) / SC →
     (lo32 (f p) : ℝ) / 10000000000 + w1 ((p : ℝ) / SC) * (s - (p : ℝ) / SC) ≤ wfun s
