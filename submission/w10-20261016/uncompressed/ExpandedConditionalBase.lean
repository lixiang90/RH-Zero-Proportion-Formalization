    nlinarith only [h, pi_pos]
  have harg : 2 * π * t * |s| ≤ 2 * π * (17 / 20) * |s| := by
    have h := mul_le_mul_of_nonneg_right ht1
      (show 0 ≤ 2 * π * |s| by positivity)
    nlinarith only [h]
