theorem cellN_soundZ' (c : CellN) (w : ℕ) (hc : c.okC = true)
   (hW : (w : ℤ) * c.DHIZ * c.DHIZ ≤ c.NLOZ * c.NLOZ * SW) (x : ℝ)
   (hx1 : (c.LN : ℝ) / SC ≤ x) (hx2 : x ≤ (c.UN : ℝ) / SC) : (w : ℝ) / SW ≤ wfun x := by
 have hl := c.A.w_lower hc (x := x) hx1 hx2
 have hD := AMW.G.DZ_pos
