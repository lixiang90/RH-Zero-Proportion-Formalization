   rw [hs0]
   rcases eq_or_ne h 0 with rfl | h0
   · simp [sc1]
   rw [sc1, if_neg h0]
   have hp : 0 < h ^ 2 := by positivity
   have e : (h * Real.cos h - Real.sin h) / h ^ 2 - 0 - h * (-1 / 3)
