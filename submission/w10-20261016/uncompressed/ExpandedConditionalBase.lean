   have := Nat.div_add_mod c.k 2; rw [hk] at this
   have h2 : ((2 * (c.k / 2) : ℕ) : ℝ) = (c.k : ℝ) := by exact_mod_cast (by omega : 2 * (c.k / 2) = c.k)
