def sincN (t : ℝ) : ℝ := Real.sinc (π * t)
def phiC (c t : ℝ) : ℝ := t ^ 2 - (max (t - c) 0) ^ 2
def hat (s : ℝ) : ℝ := max 0 (1 - |s|)
end Meshuggah
