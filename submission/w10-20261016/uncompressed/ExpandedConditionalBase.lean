   (fun z hz => (hasDerivAt_w1 z (hc z (hx.trans hz.1) (hz.2.trans hy)).1.ne).continuousAt.continuousWithinAt)
   (fun z hz => hasDerivAt_w1 z (hc z (hx.trans hz.1.le) (hz.2.le.trans hy)).1.ne)
