namespace Pantera
export Meshuggah (sincN phiC hat)
def sep : ℝ := 17 / 20
def gammaM : ℝ := 13 / 20
def gMaj (u : ℝ) : ℝ := gammaM * (sincN (sep * (u - 1 / 2)) + sincN (sep * (u + 1 / 2))) ^ 2
def LMaj : ℝ := 2 * gammaM / sep * (1 + sincN sep)
end Pantera
