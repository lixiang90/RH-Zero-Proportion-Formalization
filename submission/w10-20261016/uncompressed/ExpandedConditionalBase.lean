   filter_upwards [Metric.ball_mem_nhds (0 : ℝ) one_pos] with h hh
   rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs] at hh
   simp only [zero_add, smul_eq_mul, Real.norm_eq_abs, one_mul]
   rw [abs_of_nonneg (sq_nonneg h)]
