 have hπ := Real.pi_pos.ne'
 rw [sc2_q h2, (sin_pi_shift x j).2, (cos_pi_shift x j).2]
 unfold hf; simp only [if_pos rfl, one_ne_zero, if_false, if_true, show (2:ℕ) ≠ 0 by norm_num, show (2:ℕ) ≠ 1 by norm_num]
