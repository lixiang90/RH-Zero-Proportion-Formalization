   JInf * MAM ^ 2
     = ∫ s in (-(1:ℝ)/2)..(1/2), vAM s * ∫ t in (-(1:ℝ)/2)..(1/2), |s - t| * vAM t := by
 rw [← swap_identity vAM_continuous abs_vAM_le]
 unfold JInf vConvAM
 have h := MAM_pos
