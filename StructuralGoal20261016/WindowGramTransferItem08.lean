def scalar8 (g : Fin 9 → ℝ) (t : Fin 41) : ℝ :=
  V8 t+S8 t*(span g t-span q8 t)+A8 t*(span g t-span q8 t)^2
def remainder8 (g : Fin 9 → ℝ) : ℝ := ∑ t : Fin 41,
  if (pairJ t : ℕ) = (pairI t : ℕ)+1 then 0
  else weight t*A8 t*(span g t-span q8 t)^2

theorem remainder8_nonneg (g : Fin 9 → ℝ) : 0 ≤ remainder8 g := by
  have hA (t : Fin 41) : 0 ≤ A8 t := by
    fin_cases t <;> norm_num [A8]
  apply Finset.sum_nonneg
  intro t _
  split_ifs
  · exact le_rfl
  · exact mul_nonneg (mul_nonneg (weight_nonneg t) (hA t)) (sq_nonneg _)

theorem expansion8 (g : Fin 9 → ℝ) :
    pressure g+∑ t, weight t*scalar8 g t =
      (C8+∑ r, (b8 r*(g r-q8 r)+d8 r*(g r-q8 r)^2))+remainder8 g := by
  simp [pressure, scalar8, remainder8, span, ptsN,
    C8, b8, d8, q8, V8, S8, A8, pairI, pairJ, weight,
    StructuralW10Followup20261016.NewLedger.W,
    StructuralW10Followup20261016.NewLedger.b,
    StructuralW10Followup20261016.NewLedger.bN,
    Fin.sum_univ_succ, Fin.succ] <;> ring

/-- The 41 pointwise analytic inputs are all explicit in scalar8. -/
theorem actual8 (g : Fin 9 → ℝ)
    (hs : ∀ t : Fin 41, scalar8 g t ≤
      WindowKernel.w 24 WindowKernel.d24 (span g t)) :
    (221 : ℝ)/25000 ≤ WindowGapEnergy.Fw24 g := by
  have h := scalar_sum_le g (scalar8 g) hs
  rw [expansion8] at h
  exact (lower8 (fun r => g r-q8 r)).trans
    ((le_add_of_nonneg_right (remainder8_nonneg g)).trans h)
#print axioms actual8
