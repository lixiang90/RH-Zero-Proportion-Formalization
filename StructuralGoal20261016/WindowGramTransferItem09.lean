def scalar9 (g : Fin 9 → ℝ) (t : Fin 41) : ℝ :=
  V9 t+S9 t*(span g t-span q9 t)+A9 t*(span g t-span q9 t)^2
def remainder9 (g : Fin 9 → ℝ) : ℝ := ∑ t : Fin 41,
  if (pairJ t : ℕ) = (pairI t : ℕ)+1 then 0
  else weight t*A9 t*(span g t-span q9 t)^2

theorem remainder9_nonneg (g : Fin 9 → ℝ) : 0 ≤ remainder9 g := by
  have hA (t : Fin 41) : 0 ≤ A9 t := by
    fin_cases t <;> norm_num [A9]
  apply Finset.sum_nonneg
  intro t _
  split_ifs
  · exact le_rfl
  · exact mul_nonneg (mul_nonneg (weight_nonneg t) (hA t)) (sq_nonneg _)

theorem expansion9 (g : Fin 9 → ℝ) :
    pressure g+∑ t, weight t*scalar9 g t =
      (C9+∑ r, (b9 r*(g r-q9 r)+d9 r*(g r-q9 r)^2))+remainder9 g := by
  simp [pressure, scalar9, remainder9, span, ptsN,
    C9, b9, d9, q9, V9, S9, A9, pairI, pairJ, weight,
    StructuralW10Followup20261016.NewLedger.W,
    StructuralW10Followup20261016.NewLedger.b,
    StructuralW10Followup20261016.NewLedger.bN,
    Fin.sum_univ_succ, Fin.succ] <;> ring

/-- The 41 pointwise analytic inputs are all explicit in scalar9. -/
theorem actual9 (g : Fin 9 → ℝ)
    (hs : ∀ t : Fin 41, scalar9 g t ≤
      WindowKernel.w 24 WindowKernel.d24 (span g t)) :
    (221 : ℝ)/25000 ≤ WindowGapEnergy.Fw24 g := by
  have h := scalar_sum_le g (scalar9 g) hs
  rw [expansion9] at h
  exact (lower9 (fun r => g r-q9 r)).trans
    ((le_add_of_nonneg_right (remainder9_nonneg g)).trans h)
#print axioms actual9
