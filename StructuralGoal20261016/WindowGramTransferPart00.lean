def scalar0 (g : Fin 9 → ℝ) (t : Fin 41) : ℝ :=
  V0 t+S0 t*(span g t-span q0 t)+A0 t*(span g t-span q0 t)^2
def remainder0 (g : Fin 9 → ℝ) : ℝ := ∑ t : Fin 41,
  if (pairJ t : ℕ) = (pairI t : ℕ)+1 then 0
  else weight t*A0 t*(span g t-span q0 t)^2

theorem remainder0_nonneg (g : Fin 9 → ℝ) : 0 ≤ remainder0 g := by
  have hA (t : Fin 41) : 0 ≤ A0 t := by
    fin_cases t <;> norm_num [A0]
  apply Finset.sum_nonneg
  intro t _
  split_ifs
  · exact le_rfl
  · exact mul_nonneg (mul_nonneg (weight_nonneg t) (hA t)) (sq_nonneg _)

theorem expansion0 (g : Fin 9 → ℝ) :
    pressure g+∑ t, weight t*scalar0 g t =
      (C0+∑ r, (b0 r*(g r-q0 r)+d0 r*(g r-q0 r)^2))+remainder0 g := by
  simp [pressure, scalar0, remainder0, span, ptsN,
    C0, b0, d0, q0, V0, S0, A0, pairI, pairJ, weight,
    StructuralW10Followup20261016.NewLedger.W,
    StructuralW10Followup20261016.NewLedger.b,
    StructuralW10Followup20261016.NewLedger.bN,
    Fin.sum_univ_succ, Fin.succ] <;> ring

/-- The 41 pointwise analytic inputs are all explicit in scalar0. -/
theorem actual0 (g : Fin 9 → ℝ)
    (hs : ∀ t : Fin 41, scalar0 g t ≤
      WindowKernel.w 24 WindowKernel.d24 (span g t)) :
    (221 : ℝ)/25000 ≤ WindowGapEnergy.Fw24 g := by
  have h := scalar_sum_le g (scalar0 g) hs
  rw [expansion0] at h
  exact (lower0 (fun r => g r-q0 r)).trans
    ((le_add_of_nonneg_right (remainder0_nonneg g)).trans h)
#print axioms actual0
