+
+
+class TraceHashGraph:
+    """Lake ModuleImportInfo/ModuleExportInfo arithmetic, no SDK calls.
+
+    nodes contain pinned source header flags and verified output_hashes. SDK
+    imports have no Lake package Module and are ignored just as findModules.
+    """
+    def __init__(self,nodes):
+        self.nodes=nodes;self.art_memo={};self.trans_memo={};self.active=set()
+
+    def artifact(self,module,mode):
+        key=(module,mode)
+        if key in self.art_memo:return self.art_memo[key]
+        node=self.nodes[module];assert node['owner']!='SDK'
+        suffixes=['olean']
+        if node['is_module']:
+            if mode=='meta':suffixes=['olean','ir.sig','ir']
+            elif mode=='all':suffixes=['olean','olean.server','olean.private','ir.sig','ir']
+        assert mode in ['public','meta','all']
+        h=1723
+        for suffix in suffixes:h=mix(h,node['output_hashes'][suffix])
+        self.art_memo[key]=h;return h
+
+    def transitive(self,module,kind):
+        key=(module,kind)
+        if key in self.trans_memo:return self.trans_memo[key]
+        assert key not in self.active;self.active.add(key)
+        h=1723
+        for imp in self.nodes[module]['import_details']:
+            dep=imp['module']
+            if self.nodes[dep]['owner']=='SDK':continue
+            if kind=='legacy':child,arts='legacy','all'
+            elif kind=='meta':child,arts='meta','meta'
+            elif kind=='all':
+                if imp['import_all']:child,arts='all','all'
+                elif imp['is_meta']:child,arts='meta','meta'
+                else:child,arts='public','public'
+            else:
+                assert kind=='public'
+                if not imp['is_exported']:continue
+                child=arts='meta' if imp['is_meta'] else 'public'
+            h=mix(h,self.transitive(dep,child));h=mix(h,self.artifact(dep,arts))
+        self.active.remove(key);self.trans_memo[key]=h;return h
+
+    def import_inputs(self,module):
+        node=self.nodes[module];result=[]
+        for imp in node['import_details']:
+            dep=imp['module']
+            if self.nodes[dep]['owner']=='SDK':continue
+            if not node['is_module']:kind,arts='legacy','all'
+            elif imp['import_all']:kind,arts='all','all'
+            elif imp['is_meta']:kind,arts='meta','meta'
+            else:kind,arts='public','public'
+            art_caption={'all':':importAllArts','meta':':importArts (meta)','public':':importArts'}[arts]
+            result += [[dep+' transitive imports ('+kind+')',f'{self.transitive(dep,kind):016x}'],
+                       [dep+art_caption,f'{self.artifact(dep,arts):016x}']]
+        return result
 
 
