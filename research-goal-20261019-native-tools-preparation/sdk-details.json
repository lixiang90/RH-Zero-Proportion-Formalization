      {
        "line": 71,
        "text": "/-- The path to the executable in the package's `binDir`. -/"
      },
      {
        "line": 72,
        "text": "@[inline] public def file (self : LeanExe) : FilePath :="
      },
      {
        "line": 73,
        "text": "  self.pkg.binDir / self.fileName"
      },
      {
        "line": 74,
        "text": ""
      },
      {
        "line": 75,
        "text": "/-- The executable's `supportInterpreter` configuration. -/"
      },
      {
        "line": 76,
        "text": "@[inline] public def supportInterpreter (self : LeanExe) : Bool :="
      },
      {
        "line": 77,
        "text": "  self.config.supportInterpreter"
      },
      {
        "line": 78,
        "text": ""
      },
      {
        "line": 79,
        "text": "/--"
      },
      {
        "line": 80,
        "text": "Additional link arguments to pass `leanc` when linking the module root"
      },
      {
        "line": 81,
        "text": "into a binary executable. This excludes the arguments already present in"
      },
      {
        "line": 82,
        "text": "`self.root.linkArgs`."
      },
      {
        "line": 83,
        "text": ""
      },
      {
        "line": 84,
        "text": "If `supportInterpreter := true`, Lake adds `-rdynamic` on non-Windows"
      },
      {
        "line": 85,
        "text": "systems. On Windows, it links in a manifest for Unicode path support."
      },
      {
        "line": 86,
        "text": "-/"
      },
      {
        "line": 87,
        "text": "public def exeOnlyLinkArgs (self : LeanExe) : Array String :="
      },
      {
        "line": 88,
        "text": "  if System.Platform.isWindows then"
      },
      {
        "line": 89,
        "text": "    #[\"-Wl,--whole-archive\", \"-lleanmanifest\", \"-Wl,--no-whole-archive\"]"
      },
      {
        "line": 90,
        "text": "  else if self.config.supportInterpreter then"
      },
      {
        "line": 91,
        "text": "    #[\"-rdynamic\"]"
      },
      {
        "line": 92,
        "text": "  else"
      },
      {
        "line": 93,
        "text": "    #[]"
      },
      {
        "line": 94,
        "text": ""
      },
      {
        "line": 95,
        "text": "/--"
      },
      {
        "line": 96,
        "text": "The arguments to pass to `leanc` when linking the binary executable."
      },
      {
        "line": 97,
        "text": ""
      },
      {
        "line": 98,
        "text": "By default, the package's plus the executable's `moreLinkArgs`."
      },
      {
        "line": 99,
        "text": "If `supportInterpreter := true`, Lake adds `-rdynamic` on non-Windows"
      },
      {
        "line": 100,
        "text": "systems. On Windows, it links in a manifest for Unicode path support."
      },
      {
        "line": 101,
        "text": "-/"
      },
      {
        "line": 102,
        "text": "public def linkArgs (self : LeanExe) : Array String :="
      },
      {
        "line": 103,
        "text": "  self.exeOnlyLinkArgs ++ self.pkg.moreLinkArgs ++ self.config.moreLinkArgs"
      },
      {
        "line": 104,
        "text": ""
      },
      {
        "line": 105,
        "text": "/--"
      },
      {
        "line": 106,
        "text": "Whether the Lean shared library should be dynamically linked to the executable."
      },
      {
        "line": 107,
        "text": ""
      },
      {
        "line": 108,
        "text": "If `supportInterpreter := true`, Lean symbols must be visible to the"
      },
      {
        "line": 109,
        "text": "interpreter. On Windows, it is not possible to statically include these"
      },
      {
        "line": 110,
        "text": "symbols in the executable due to symbol limits, so Lake dynamically links to"
      },
      {
        "line": 111,
        "text": "the Lean shared library. Otherwise, Lean is linked statically."
      },
      {
        "line": 112,
        "text": "-/"
      },
      {
        "line": 113,
        "text": "@[inline] public def sharedLean (self : LeanExe) : Bool :="
      },
      {
        "line": 114,
        "text": "  strictAnd Platform.isWindows self.config.supportInterpreter"
      },
      {
        "line": 115,
        "text": ""
      },
      {
        "line": 116,
        "text": "/--"
      },
      {
        "line": 117,
        "text": "The arguments to weakly pass to `leanc` when linking the binary executable."
      },
      {
        "line": 118,
        "text": "That is, the package's `weakLinkArgs` plus the executable's  `weakLinkArgs`."
