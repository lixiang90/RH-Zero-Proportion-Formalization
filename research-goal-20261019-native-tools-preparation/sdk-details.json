      {
        "line": 104,
        "text": "/--"
      },
      {
        "line": 105,
        "text": "Initialize Lean's search path given Lean's system root and an initial search path."
      },
      {
        "line": 106,
        "text": "The system root can be obtained via `getBuildDir` (for internal use) or"
      },
      {
        "line": 107,
        "text": "`findSysroot` (for external users). -/"
      },
      {
        "line": 108,
        "text": "def initSearchPath (leanSysroot : FilePath) (sp : SearchPath := ∅) : IO Unit := do"
      },
      {
        "line": 109,
        "text": "  let sp := sp ++ (← addSearchPathFromEnv (← getBuiltinSearchPath leanSysroot))"
      },
      {
        "line": 110,
        "text": "  searchPathRef.set sp"
      },
      {
        "line": 111,
        "text": ""
      },
      {
        "line": 112,
        "text": "@[export lean_init_search_path]"
      },
      {
        "line": 113,
        "text": "private def initSearchPathInternal : IO Unit := do"
      },
      {
        "line": 114,
        "text": "  initSearchPath (← getBuildDir)"
      },
      {
        "line": 115,
        "text": ""
      },
      {
        "line": 116,
        "text": "/-- Find the compiled `.olean` of a module in the `LEAN_PATH` search path. -/"
      },
      {
        "line": 117,
        "text": "partial def findOLean (mod : Name) : IO FilePath := do"
      },
      {
        "line": 118,
        "text": "  let sp ← searchPathRef.get"
      },
      {
        "line": 119,
        "text": "  if let some fname ← sp.findWithExt \"olean\" mod then"
      },
      {
        "line": 171,
        "text": "/--"
      },
      {
        "line": 172,
        "text": "  Find the system root of the given `lean` command"
      },
      {
        "line": 173,
        "text": "  by calling `lean --print-prefix` and returning the path it prints."
      },
      {
        "line": 174,
        "text": "  Defaults to trying the `lean` in `PATH`."
      },
      {
        "line": 175,
        "text": "  If set, the `LEAN_SYSROOT` environment variable takes precedence."
      },
      {
        "line": 176,
        "text": "  Note that the called `lean` binary might not be part of the system root,"
      },
      {
        "line": 177,
        "text": "  e.g. in the case of `elan`'s proxy binary."
      },
      {
        "line": 178,
        "text": "  Users internal to Lean should use `Lean.getBuildDir` instead."
      },
      {
        "line": 179,
        "text": "-/"
      },
      {
        "line": 180,
        "text": "def findSysroot (lean := \"lean\") : IO FilePath := do"
      },
      {
        "line": 181,
        "text": "  if let some root ← IO.getEnv \"LEAN_SYSROOT\" then"
      },
      {
        "line": 182,
        "text": "    return root"
      },
      {
        "line": 183,
        "text": "  let out ← IO.Process.run {"
      },
      {
        "line": 184,
        "text": "    cmd := lean"
      },
      {
        "line": 185,
        "text": "    args := #[\"--print-prefix\"]"
      },
      {
        "line": 186,
        "text": "  }"
      },
      {
        "line": 187,
        "text": "  return out.trimAscii.copy"
      },
      {
        "line": 188,
        "text": ""
      },
      {
        "line": 189,
        "text": "end Lean"
      }
    ]
