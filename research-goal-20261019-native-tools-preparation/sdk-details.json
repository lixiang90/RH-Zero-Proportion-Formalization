        "line": 22,
        "text": "def LeanExe.recBuildExe (self : LeanExe) : FetchM (Job FilePath) :="
      },
      {
        "line": 23,
        "text": "  withRegisterJob s!\"{self.name}:exe\" <| withCurrPackage self.pkg do"
      },
      {
        "line": 24,
        "text": "  let infoJob ←"
      },
      {
        "line": 25,
        "text": "    if self.supportInterpreter"
      },
      {
        "line": 26,
        "text": "    then self.root.linkInfoExport.fetch"
      },
      {
        "line": 27,
        "text": "    else self.root.linkInfoNoExport.fetch"
      },
      {
        "line": 28,
        "text": "  infoJob.mapM fun info => do"
      },
      {
        "line": 29,
        "text": "    let args := self.exeOnlyLinkArgs ++ info.args"
      },
      {
        "line": 30,
        "text": "    addPureTrace self.exeOnlyLinkArgs \"LeanExe.exeOnlyLinkArgs\""
      },
      {
        "line": 31,
        "text": "    buildLeanExeSync self.file info.objs info.libs args self.sharedLean"
      },
