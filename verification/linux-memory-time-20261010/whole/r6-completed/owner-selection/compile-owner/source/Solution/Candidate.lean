 have m2 : ∀ p : ℕ, 1 / (b + j) ^ p ≤ 1 / (a + j) ^ p := fun p =>
   one_div_le_one_div_of_le (pow_pos hapj p) (pow_le_pow_left₀ hapj.le (by linarith) p)
 have m1' := m1 1; have m2' := m2 1; simp only [pow_one] at m1' m2'
 split_ifs
 · linarith
 · linarith [m1 2, m2 2]
 · linarith [m1 3, m2 3]
