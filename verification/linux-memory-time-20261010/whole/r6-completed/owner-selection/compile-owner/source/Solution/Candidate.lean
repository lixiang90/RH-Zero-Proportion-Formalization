    simp only [gsum_range, Nat.add_sub_cancel_left, Finset.sum_range_one, Nat.add_zero] at hc
    nlinarith
  constructor
  · apply (div_le_iff₀ hSC).mpr
    simp only [tightLower,Nat.cast_max]
    apply max_le
    · have h := (div_le_iff₀ hSC).mp hbase.1; nlinarith
