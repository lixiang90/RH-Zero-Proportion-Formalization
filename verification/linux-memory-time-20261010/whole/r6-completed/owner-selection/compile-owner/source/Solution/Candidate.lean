theorem integrable_swap (hq : Continuous q) (hB : ∀ s, |q s| ≤ B) :
   Integrable (fun p : ℝ × ℝ => ext0 q p.1 * (|p.2| * ext0 q (p.1 + p.2)))
     (volume.prod volume) := by
