   by_cases h1 : p.1 ∈ Icc (-(1:ℝ)/2) (1/2)
   · by_cases h2 : p.1 + p.2 ∈ Icc (-(1:ℝ)/2) (1/2)
     · have hpK : p ∈ K := ⟨h1, by constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]⟩
       rw [Set.indicator_of_mem hpK, abs_mul, abs_mul, abs_abs]
