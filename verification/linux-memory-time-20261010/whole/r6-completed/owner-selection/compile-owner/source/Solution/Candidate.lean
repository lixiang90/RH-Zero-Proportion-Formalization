theorem energy_total :
   (∫ t in (-(1:ℝ)/2)..(1/2), vAM t ^ 2)
     + (∫ s in (-(1:ℝ)/2)..(1/2), vAM s * ∫ t in (-(1:ℝ)/2)..(1/2), |s - t| * vAM t)
     = Real.sin (Real.sqrt 2 / 2) ^ 2
