   have hr := c.roff_near h.1 x
   have hs : Real.sinc (π * (x - ((c.k / 2 : ℕ) : ℝ))) = Real.sinc (π * c.roff x) := by
     rw [hr]; split_ifs
     · rfl
     · exact Real.sinc_neg _
   rw [hj0'] at hv
   convert hS using 1
   rw [hs, hj0', ← hv, Nat.mul_eq]; push_cast; ring
