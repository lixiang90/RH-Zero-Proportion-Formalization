theorem kernel_cos {ω s : ℝ} (hω : ω ≠ 0) (hs1 : -(1:ℝ)/2 ≤ s) (hs2 : s ≤ 1/2) :
   ∫ t in (-(1:ℝ)/2)..(1/2), |s - t| * Real.cos (ω * t)
     = Real.sin (ω / 2) / ω + 2 * Real.cos (ω / 2) / ω ^ 2 - 2 * Real.cos (ω * s) / ω ^ 2 := by
