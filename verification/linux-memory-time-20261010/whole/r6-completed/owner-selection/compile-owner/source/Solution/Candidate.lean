   Wmat hP.1.eigenvalues (eigCols hP)
     = (hP.1.eigenvectorUnitary : Matrix n n 𝕜)
       * diagonal (fun j => ((Real.sqrt (hP.1.eigenvalues j) : ℝ) : 𝕜)) := by
 ext a j
