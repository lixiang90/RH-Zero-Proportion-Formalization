     = ∫ r in (0:ℝ)..1, (∫ s in (-(1:ℝ)/2)..(1/2 - r), q s * q (s + r)) * r := by
   apply intervalIntegral.integral_congr
   intro r hr
   rw [Set.uIcc_of_le zero_le_one] at hr
   show r * acor q r = (∫ s in (-(1:ℝ)/2)..(1/2 - r), q s * q (s + r)) * r
   rw [acor_eq_overlap hr.1 hr.2, mul_comm]
 rw [hR2, hS, hE, hI, hO]
end Swap
