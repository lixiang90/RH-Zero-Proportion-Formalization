def SF0 (c : CellA) : IV := c.SX.mul (c.FA 0)
def K0 (c : CellA) : IV := (c.NI.neg.divp c.E0 c.E1).add ((IV.mulc SIGC c.SF0).add (IV.mulc RHOC c.B0))
def MI (c : CellA) : IV :=
