structure Acc where
 (pl ph nl nh : ℕ)
def Acc.put (a : Acc) (ng : Bool) (e m0 m1 : ℕ) : Acc :=
 Bool.rec (motive := fun _ => Acc) ⟨Nat.add a.pl (qM e m0), Nat.add a.ph (qM e m1), a.nl, a.nh⟩
   ⟨a.pl, a.ph, Nat.add a.nl (qM e m0), Nat.add a.nh (qM e m1)⟩ ng
def mnum (n X X2 J2 : ℕ) : ℕ :=
 Nat.rec (motive := fun _ => ℕ) (qM X (DZp 2))
   (fun m _ => Nat.rec (motive := fun _ => ℕ) (qM (qA X2 J2) (DZp 3))
     (fun _ _ => Nat.mul (qM (qM 2 X) (qA X2 (qM 3 J2))) (DZp 4)) m) n
def hden (n Y : ℕ) : ℕ :=
 Nat.rec (motive := fun _ => ℕ) (qM 2 Y)
   (fun m _ => Nat.rec (motive := fun _ => ℕ) (qM 2 (qM Y Y)) (fun _ _ => Nat.pow Y 3) m) n
def mneg (n : ℕ) (ab : Bool) : Bool := Bool.rec (motive := fun _ => Bool) (!ab) true (qE n 1)
def hneg (n : ℕ) : Bool := Nat.beq n 1
def farJ (n k XL XU XL2 XU2 : ℕ) (a : Acc) (j e : ℕ) (sg : Bool) : Acc :=
 let J := Nat.mul j DZ
 let J2 := Nat.mul J J
 Bool.rec (motive := fun _ => Acc)
   (Bool.rec (motive := fun _ => Acc)
     (a.put (xor sg (mneg n false)) e (Nat.div (mnum n XL XL2 J2) (Nat.pow (qS J2 XL2) (Nat.succ n)))
       (ndivc (mnum n XU XU2 J2) (Nat.pow (qS J2 XU2) (Nat.succ n))))
     (a.put (xor sg (mneg n true)) e (Nat.div (mnum n XU XU2 J2) (Nat.pow (qS XU2 J2) (Nat.succ n)))
       (ndivc (mnum n XL XL2 J2) (Nat.pow (qS XL2 J2) (Nat.succ n))))
     (Nat.blt (qM 2 j) k))
   (a.put (xor sg (hneg n)) e (Nat.div (DZp (qA n 2)) (hden n (qA XU J)))
     (ndivc (DZp (qA n 2)) (hden n (qA XL J))))
   (qE (qM 2 j) k)
def farAcc (n k XL XU XL2 XU2 : ℕ) : List (ℕ × ℕ × Bool) → Acc → Acc
 | [], a => a
 | (j, e, sg) :: rest, a => farAcc n k XL XU XL2 XU2 rest (farJ n k XL XU XL2 XU2 a j e sg)
structure CellA where
 (LN UN : ℕ)
namespace CellA
def k (c : CellA) : ℕ := Nat.div (qA (qM 2 (qA c.LN c.UN)) SC) (qM 2 SC)
def side (c : CellA) : Bool := Nat.ble (qM c.k SC) (qM 2 c.LN)
def LLO (c : CellA) : ℕ := Nat.div (qM c.LN DZ) SC
def UHI (c : CellA) : ℕ := ndivc (qM c.UN DZ) SC
def AD (c : CellA) : ℕ := Nat.mul c.k DZ2
def RLO (c : CellA) : ℕ := Bool.rec (motive := fun _ => ℕ) (qS c.AD c.UHI) (qS c.LLO c.AD) c.side
def RHI (c : CellA) : ℕ := Bool.rec (motive := fun _ => ℕ) (qS c.AD c.LLO) (qS c.UHI c.AD) c.side
def TLZ (c : CellA) : ℕ := Nat.div (qM PLN c.RLO) E20
def TUZ (c : CellA) : ℕ := ndivc (qM PUN c.RHI) E20
def CI (c : CellA) : IV :=
 ⟨⟨Nat.div (qS (cosP c.TUZ) (cosN c.TUZ)) CDEN, ERRD⟩, ⟨Nat.add (ndivc (qS (cosP c.TLZ) (cosN c.TLZ)) CDEN) ERRD, 0⟩⟩
def SI (c : CellA) : IV :=
 ⟨⟨Nat.div (qS (sinP c.TLZ) (sinN c.TLZ)) SDEN, ERRD⟩, ⟨Nat.add (ndivc (qS (sinP c.TUZ) (sinN c.TUZ)) SDEN) ERRD, 0⟩⟩
