 have h2 : a ≤ (a + (b - 1)) / b * b := by
   have := Nat.lt_div_mul_add (a := a + (b - 1)) hb
   have h3 : a + (b - 1) < (a + (b - 1)) / b * b + b := by
     have := Nat.lt_div_mul_add (a := a + (b - 1)) hb; linarith
   omega
