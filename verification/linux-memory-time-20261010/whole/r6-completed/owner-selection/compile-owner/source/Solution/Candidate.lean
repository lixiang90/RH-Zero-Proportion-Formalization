   intro s
   unfold ext0
   by_cases hs : s ∈ Icc (-(1:ℝ)/2) (1/2)
   · rw [Set.indicator_of_notMem (s := Icc (-(1:ℝ)/2) (1/2)) (a := s + r), mul_zero]
     intro h; linarith [hs.1, h.2]
   · rw [Set.indicator_of_notMem hs, zero_mul]
