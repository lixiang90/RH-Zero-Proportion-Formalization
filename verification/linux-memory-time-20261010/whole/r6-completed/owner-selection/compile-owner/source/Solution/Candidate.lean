   intro x hx
   have hx1 : 1 < x := by
     rcases hx with ⟨hx0, hx1⟩
     simp only [mem_Ioc, not_and_or, not_le] at hx1
     rcases hx1 with h | h
     · exact absurd (mem_Ioi.mp hx0) h
     · exact h
   rw [acor_eq_zero hx1, mul_zero]
