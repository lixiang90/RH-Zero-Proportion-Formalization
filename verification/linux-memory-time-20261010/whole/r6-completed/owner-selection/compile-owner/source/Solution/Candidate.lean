theorem x_pos (hc : c.ok = true) {x : ℝ} (hx1 : (c.LN : ℝ) / SC ≤ x) (hx2 : x ≤ (c.UN : ℝ) / SC) : 0 < x := by
 have b := c.base_sound hc hx1 hx2
