def CX (c : CellA) : IV :=
 Bool.rec (motive := fun _ => IV)
   (Bool.rec (motive := fun _ => IV)
     (Bool.rec (motive := fun _ => IV) (Bool.rec (motive := fun _ => IV) c.SI.neg c.SI c.side) c.CI.neg (qE c.km4 2))
     (Bool.rec (motive := fun _ => IV) c.SI c.SI.neg c.side) (qE c.km4 1))
   c.CI (qE c.km4 0)
def SX (c : CellA) : IV :=
 Bool.rec (motive := fun _ => IV)
   (Bool.rec (motive := fun _ => IV)
     (Bool.rec (motive := fun _ => IV) c.CI.neg (Bool.rec (motive := fun _ => IV) c.SI c.SI.neg c.side) (qE c.km4 2))
     c.CI (qE c.km4 1))
   (Bool.rec (motive := fun _ => IV) c.SI.neg c.SI c.side) (qE c.km4 0)
def BLZ (c : CellA) : ℕ := Nat.div (qM PLN c.LLO) E20
def BUZ (c : CellA) : ℕ := ndivc (qM PUN c.UHI) E20
def BI (c : CellA) : IV := IV.ofN c.BLZ c.BUZ
def PG (c : CellA) : IV := IV.ofN (Nat.div (qM GAM0 c.BLZ) DZ) (ndivc (qM GAM1 c.BUZ) DZ)
