    rw [natList_sum_cast,List.map_map]
    change _ ≤ (((List.range (j-i)).map fun k => (cellUpper label (i+k) (i+k+1):Real)).sum)
    rw [RHWeilRecord.SparseDualSoundness.range_sum,gsum_range,Finset.mul_sum]
