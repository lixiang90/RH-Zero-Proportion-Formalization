         by linarith [h1.1, h1.2, h2.1, h2.2]⟩
       have e1 := abs_ext0_le hB p.1 (q := q)
       have e2 := abs_ext0_le hB (p.1 + p.2) (q := q)
       calc |ext0 q p.1| * (|p.2| * |ext0 q (p.1 + p.2)|) ≤ B * (1 * B) := by
             apply mul_le_mul e1 (mul_le_mul hr e2 (abs_nonneg _) zero_le_one)
